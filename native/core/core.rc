#include <winres.h>
#include "resource.h"

IDI_ATRIUM ICON "../../assets/atrium.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,3,0,0
 PRODUCTVERSION 0,3,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "Atrium contributors"
            VALUE "FileDescription", "Atrium Desktop"
            VALUE "FileVersion", "0.3.0"
            VALUE "InternalName", "Atrium.Core"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "Atrium.Core.exe"
            VALUE "ProductName", "Atrium Desktop"
            VALUE "ProductVersion", "0.3.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
