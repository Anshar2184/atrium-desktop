<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Atrium.Settings.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Atrium 设置">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Custom title bar -->
        <Grid x:Name="AppTitleBar" Padding="16,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/atrium.ico" Width="16" Height="16" />
                <TextBlock Text="Atrium 设置" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" Padding="40,0,40,0">
            <StackPanel MaxWidth="880" Padding="0,8,0,24">
                <TextBlock Text="外观" Style="{StaticResource TitleTextBlockStyle}" Margin="0,8,0,4" />
                <TextBlock Style="{StaticResource CardDescriptionStyle}"
                           Text="拖动滑块时玻璃栏会实时预览；点“保存”后才写入设置文件。关闭窗口时未保存的修改会被撤销。" />

                <InfoBar x:Name="Status" IsOpen="True" IsClosable="False" Margin="0,16,0,0">
                    <InfoBar.ActionButton>
                        <Button x:Name="StartCoreButton" Content="启动 Atrium" Click="OnStartCore" Visibility="Collapsed" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <TextBlock Text="材质" Style="{StaticResource SectionHeaderStyle}" />
                <StackPanel x:Name="MaterialPanel" Spacing="4">
                    <Grid Style="{StaticResource CardStyle}" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="预设" />
                            <TextBlock Style="{StaticResource CardDescriptionStyle}" Text="液态玻璃：边缘折射、轻度模糊；磨砂玻璃：强模糊、无折射。修改任一材质参数会变为自定义。" />
                        </StackPanel>
                        <ComboBox x:Name="PresetBox" Grid.Column="1" MinWidth="160" AutomationProperties.Name="预设" VerticalAlignment="Center" SelectionChanged="OnPresetChanged">
                            <ComboBoxItem Content="液态玻璃" Tag="liquid" />
                            <ComboBoxItem Content="磨砂玻璃" Tag="frosted" />
                            <ComboBoxItem Content="自定义" Tag="custom" />
                        </ComboBox>
                    </Grid>
                    <Grid Style="{StaticResource CardStyle}" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="染色" />
                            <TextBlock Style="{StaticResource CardDescriptionStyle}" Text="玻璃混入的颜色，混入多少由“透明度”决定。" />
                        </StackPanel>
                        <Button x:Name="TintButton" Grid.Column="1" Padding="4" VerticalAlignment="Center">
                            <Border x:Name="TintSwatch" Width="48" Height="24" CornerRadius="4"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                            <Button.Flyout>
                                <Flyout>
                                    <ColorPicker x:Name="TintPicker" IsAlphaEnabled="False" IsMoreButtonVisible="True"
                                                 ColorChanged="OnTintChanged" />
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>
                </StackPanel>

                <TextBlock Text="形状与位置" Style="{StaticResource SectionHeaderStyle}" />
                <StackPanel x:Name="LayoutPanel" Spacing="4">
                    <Grid x:Name="AutoWidthCard" Style="{StaticResource CardStyle}" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="自动宽度" />
                            <TextBlock Style="{StaticResource CardDescriptionStyle}" Text="玻璃栏随内容伸缩；关闭后固定为“最大宽度”。" />
                        </StackPanel>
                        <ToggleSwitch x:Name="AutoWidthSwitch" Grid.Column="1" OnContent="开" OffContent="关" MinWidth="0"
                                      AutomationProperties.Name="自动宽度" VerticalAlignment="Center" Toggled="OnAutoWidthToggled" />
                    </Grid>
                </StackPanel>

                <TextBlock Text="固定的应用" Style="{StaticResource SectionHeaderStyle}" />
                <Grid Style="{StaticResource CardStyle}" Padding="16,4,16,12" MinHeight="0">
                    <StackPanel>
                        <StackPanel x:Name="PinsList" />
                        <TextBlock x:Name="PinsEmpty" Text="还没有固定的应用。" Style="{StaticResource CardDescriptionStyle}"
                                   Margin="0,16,0,8" Visibility="Collapsed" />
                        <Border Height="1" Margin="0,4,0,12" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="AddPinButton" Click="OnAddPin">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                                    <TextBlock Text="添加应用…" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="ImportPinsButton" Click="OnImportPins">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE896;" FontSize="14" />
                                    <TextBlock Text="导入系统任务栏固定项" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <TextBlock Text="内容" Style="{StaticResource SectionHeaderStyle}" />
                <StackPanel Spacing="4">
                <Grid Style="{StaticResource CardStyle}" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="显示时钟和日期" />
                        <TextBlock Style="{StaticResource CardDescriptionStyle}" Text="使用系统的时间与日期格式。" />
                    </StackPanel>
                    <ToggleSwitch x:Name="ClockSwitch" Grid.Column="1" OnContent="开" OffContent="关" MinWidth="0"
                                  AutomationProperties.Name="显示时钟和日期" VerticalAlignment="Center" Toggled="OnClockToggled" />
                </Grid>
                <Grid Style="{StaticResource CardStyle}" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="显示正在运行的应用" />
                        <TextBlock Style="{StaticResource CardDescriptionStyle}" Text="在固定的应用之后显示未固定但正在运行的应用。" />
                    </StackPanel>
                    <ToggleSwitch x:Name="RunningSwitch" Grid.Column="1" OnContent="开" OffContent="关" MinWidth="0"
                                  AutomationProperties.Name="显示正在运行的应用" VerticalAlignment="Center" Toggled="OnRunningToggled" />
                </Grid>
                <Grid Style="{StaticResource CardStyle}" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="文字颜色" />
                        <TextBlock Style="{StaticResource CardDescriptionStyle}" Text="自动：按玻璃下方背景的明暗选择。" />
                    </StackPanel>
                    <ComboBox x:Name="TextColorBox" Grid.Column="1" MinWidth="160" VerticalAlignment="Center"
                              AutomationProperties.Name="文字颜色" SelectionChanged="OnTextColorChanged">
                        <ComboBoxItem Content="自动" Tag="auto" />
                        <ComboBoxItem Content="浅色" Tag="light" />
                        <ComboBoxItem Content="深色" Tag="dark" />
                    </ComboBox>
                </Grid>
                </StackPanel>

                <TextBlock x:Name="PathText" Style="{StaticResource CardDescriptionStyle}" Margin="2,24,0,0" IsTextSelectionEnabled="True" />
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Grid Grid.Row="2" Padding="40,12,40,16" Background="{ThemeResource LayerFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid MaxWidth="880">
                <Button Content="恢复默认" Click="OnDefaults" HorizontalAlignment="Left" />
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button x:Name="RevertButton" Content="撤销修改" Click="OnRevert" IsEnabled="False" />
                    <Button x:Name="SaveButton" Content="保存" Click="OnSave" IsEnabled="False" Style="{StaticResource AccentButtonStyle}" MinWidth="96" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
