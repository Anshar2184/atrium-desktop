<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Atrium.Settings.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ============ Tokens (DESIGN.md §1, §5, §8) ============
                 One accent, neutrals for everything else. Light and dark follow Windows. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="PageBrush" Color="#FFF5F5F7" />
                    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="CardStrokeBrush" Color="#0F000000" />
                    <SolidColorBrush x:Key="TileActiveBrush" Color="#FFF3F7FF" />
                    <SolidColorBrush x:Key="SeparatorBrush" Color="#FFE8E8ED" />
                    <SolidColorBrush x:Key="InkBrush" Color="#FF1D1D1F" />
                    <SolidColorBrush x:Key="InkSecondaryBrush" Color="#FF6E6E73" />
                    <SolidColorBrush x:Key="InkTertiaryBrush" Color="#FFA1A1A6" />
                    <SolidColorBrush x:Key="FillBrush" Color="#FFE8E8ED" />
                    <SolidColorBrush x:Key="FillHoverBrush" Color="#FFDDDDE3" />
                    <SolidColorBrush x:Key="FillPressedBrush" Color="#FFD2D2D8" />
                    <SolidColorBrush x:Key="HoverBrush" Color="#0A000000" />
                    <SolidColorBrush x:Key="PressedBrush" Color="#14000000" />
                    <SolidColorBrush x:Key="KnobBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="KnobStrokeBrush" Color="#1F000000" />
                    <SolidColorBrush x:Key="SegmentSelectedBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="ButtonBackground" Color="#FFE8E8ED" />
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FFDDDDE3" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#FFD2D2D8" />
                    <SolidColorBrush x:Key="ButtonForeground" Color="#FF1D1D1F" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FF1D1D1F" />
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FF1D1D1F" />
                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="PageBrush" Color="#FF1C1C1E" />
                    <SolidColorBrush x:Key="CardBrush" Color="#FF2C2C2E" />
                    <SolidColorBrush x:Key="CardStrokeBrush" Color="#14FFFFFF" />
                    <SolidColorBrush x:Key="TileActiveBrush" Color="#FF32363E" />
                    <SolidColorBrush x:Key="SeparatorBrush" Color="#FF3A3A3C" />
                    <SolidColorBrush x:Key="InkBrush" Color="#FFF5F5F7" />
                    <SolidColorBrush x:Key="InkSecondaryBrush" Color="#FFA1A1A6" />
                    <SolidColorBrush x:Key="InkTertiaryBrush" Color="#FF6E6E73" />
                    <SolidColorBrush x:Key="FillBrush" Color="#FF3A3A3C" />
                    <SolidColorBrush x:Key="FillHoverBrush" Color="#FF48484A" />
                    <SolidColorBrush x:Key="FillPressedBrush" Color="#FF545456" />
                    <SolidColorBrush x:Key="HoverBrush" Color="#0FFFFFFF" />
                    <SolidColorBrush x:Key="PressedBrush" Color="#1AFFFFFF" />
                    <SolidColorBrush x:Key="KnobBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="KnobStrokeBrush" Color="#33000000" />
                    <SolidColorBrush x:Key="SegmentSelectedBrush" Color="#FF636366" />
                    <SolidColorBrush x:Key="ButtonBackground" Color="#FF3A3A3C" />
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FF48484A" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#FF545456" />
                    <SolidColorBrush x:Key="ButtonForeground" Color="#FFF5F5F7" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFF5F5F7" />
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFF5F5F7" />
                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- The accent is Atrium's blue whatever Windows' accent is. -->
            <Color x:Key="SystemAccentColor">#FF0A84FF</Color>
            <Color x:Key="SystemAccentColorLight1">#FF409CFF</Color>
            <Color x:Key="SystemAccentColorLight2">#FF64B0FF</Color>
            <Color x:Key="SystemAccentColorLight3">#FF8DC4FF</Color>
            <Color x:Key="SystemAccentColorDark1">#FF0077ED</Color>
            <Color x:Key="SystemAccentColorDark2">#FF006ADB</Color>
            <Color x:Key="SystemAccentColorDark3">#FF005BC4</Color>
            <SolidColorBrush x:Key="TransparentBrush" Color="Transparent" />
            <SolidColorBrush x:Key="AccentBrush" Color="#FF0A84FF" />
            <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF2490FF" />
            <SolidColorBrush x:Key="AccentPressedBrush" Color="#FF0072E0" />
            <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFFFF" />

            <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
            <CornerRadius x:Key="OverlayCornerRadius">14</CornerRadius>

            <!-- ============ Type (D40): MiSans, three files, one weight each ============
                 Medium 380 reads as a regular, Demibold 450 as a medium, Semibold 520 as a semibold.
                 Weights are never synthesised: a style picks the file, FontWeight stays Normal. -->
            <FontFamily x:Key="TextFont">ms-appx:///Fonts/MiSans-Medium.otf#MiSans, Segoe UI Variable Text, Microsoft YaHei UI</FontFamily>
            <FontFamily x:Key="EmphasisFont">ms-appx:///Fonts/MiSans-Demibold.otf#MiSans, Segoe UI Variable Text, Microsoft YaHei UI</FontFamily>
            <FontFamily x:Key="TitleFont">ms-appx:///Fonts/MiSans-Semibold.otf#MiSans, Segoe UI Variable Display, Microsoft YaHei UI</FontFamily>
            <StaticResource x:Key="DisplayFont" ResourceKey="TitleFont" />
            <StaticResource x:Key="ContentControlThemeFontFamily" ResourceKey="TextFont" />

            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
                <Setter Property="FontWeight" Value="Normal" />
            </Style>
            <Style x:Key="LargeTitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource TitleFont}" />
                <Setter Property="FontSize" Value="30" />
                <Setter Property="LineHeight" Value="38" />
                <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
                <Setter Property="CharacterSpacing" Value="-10" />
                <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
            </Style>
            <Style x:Key="TitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource TitleFont}" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="LineHeight" Value="26" />
                <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
                <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
            </Style>
            <Style x:Key="SubtitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="LineHeight" Value="22" />
                <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
                <Setter Property="Foreground" Value="{ThemeResource InkSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="RowTitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="LineHeight" Value="20" />
                <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
                <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
            <Style x:Key="RowNoteStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="LineHeight" Value="19" />
                <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
                <Setter Property="Foreground" Value="{ThemeResource InkSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="FootnoteStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="LineHeight" Value="17" />
                <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
                <Setter Property="Foreground" Value="{ThemeResource InkTertiaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="ValueStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource EmphasisFont}" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="Foreground" Value="{ThemeResource InkSecondaryBrush}" />
                <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
                <Setter Property="TextAlignment" Value="Right" />
            </Style>

            <!-- ============ Surfaces ============ -->
            <!-- A scrolling column: never scrolled sideways. -->
            <Style x:Key="PageStyle" TargetType="ScrollViewer">
                <Setter Property="HorizontalScrollMode" Value="Disabled" />
                <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            </Style>
            <!-- Bottom scroll room lets the last control clear the desktop dock. -->
            <Style x:Key="WorkspaceStackStyle" TargetType="StackPanel">
                <Setter Property="MaxWidth" Value="1120" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="Margin" Value="32,24,32,160" />
                <Setter Property="Spacing" Value="24" />
            </Style>
            <Style x:Key="InspectorStackStyle" TargetType="StackPanel">
                <Setter Property="Margin" Value="24,24,24,160" />
            </Style>
            <Style x:Key="InspectorPageStyle" TargetType="StackPanel">
                <Setter Property="Spacing" Value="24" />
            </Style>
            <!-- A row of the inspector: no card, a little air above and below (DESIGN.md §8). -->
            <Style x:Key="FlatRowStyle" TargetType="StackPanel">
                <Setter Property="Spacing" Value="8" />
                <Setter Property="Padding" Value="4,10,4,12" />
            </Style>
            <Style x:Key="FlatTileStyle" TargetType="Border">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="12,10,12,12" />
                <Setter Property="Margin" Value="-8,0,-8,0" />
            </Style>
            <!-- "Restore defaults" beside a group's title: quiet until the pointer is on it. -->
            <Style x:Key="ResetButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Content" Value="恢复默认" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource InkTertiaryBrush}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Padding" Value="8,2,8,3" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="Margin" Value="0,-4,-8,0" />
            </Style>
            <!-- A tile: one setting on a small card; tiles sit three to a row (ResponsiveGrid). -->
            <Style x:Key="TileStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Padding" Value="18,15,18,16" />
            </Style>
            <Style x:Key="SectionStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource EmphasisFont}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{ThemeResource InkSecondaryBrush}" />
                <Setter Property="Margin" Value="4,0,0,10" />
            </Style>
            <Style x:Key="GroupStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="16" />
            </Style>

            <!-- ============ Buttons ============ -->
            <SolidColorBrush x:Key="AccentButtonBackground" Color="#FF0A84FF" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#FF2490FF" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#FF0072E0" />
            <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="Transparent" />
            <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Padding" Value="14,6,14,7" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="FontSize" Value="14" />
            </Style>
            <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="Padding" Value="16,6,16,7" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontFamily" Value="{StaticResource EmphasisFont}" />
            </Style>
            <!-- A quiet icon button (in lists): no fill until the pointer is over it. -->
            <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Width" Value="34" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Foreground" Value="{ThemeResource InkSecondaryBrush}" />
            </Style>

            <!-- ============ Switch: a 44 x 26 capsule, the knob slides ============ -->
            <Style x:Key="SwitchStyle" TargetType="ToggleSwitch">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="OnContent" Value="" />
                <Setter Property="OffContent" Value="" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleSwitch">
                            <!-- SwitchThumb takes the clicks and drags, SwitchKnob is what a drag moves within SwitchKnobBounds (WinUI's part names). -->
                            <Grid x:Name="Root" Width="44" Height="26" Background="Transparent">
                                <Border x:Name="Track" CornerRadius="13" Background="{ThemeResource FillBrush}" />
                                <Border x:Name="TrackOn" CornerRadius="13" Background="{ThemeResource AccentBrush}" Opacity="0" />
                                <Rectangle x:Name="SwitchKnobBounds" Margin="2,0,2,0" Fill="Transparent" />
                                <Grid x:Name="SwitchKnob" Width="22" Height="22" HorizontalAlignment="Left" Margin="2,0,0,0">
                                    <Grid.RenderTransform>
                                        <TranslateTransform x:Name="KnobTranslateTransform" />
                                    </Grid.RenderTransform>
                                    <Ellipse Fill="{ThemeResource KnobBrush}" Stroke="{ThemeResource KnobStrokeBrush}" StrokeThickness="0.5" />
                                </Grid>
                                <Thumb x:Name="SwitchThumb" AutomationProperties.AccessibilityView="Raw">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Rectangle Fill="Transparent" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Track.Background" Value="{ThemeResource FillHoverBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Track.Background" Value="{ThemeResource FillPressedBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Opacity" Value="0.4" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="ToggleStates">
                                        <VisualStateGroup.Transitions>
                                            <VisualTransition GeneratedDuration="0:0:0.22">
                                                <VisualTransition.GeneratedEasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </VisualTransition.GeneratedEasingFunction>
                                            </VisualTransition>
                                        </VisualStateGroup.Transitions>
                                        <VisualState x:Name="Dragging" />
                                        <VisualState x:Name="Off" />
                                        <VisualState x:Name="On">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="KnobTranslateTransform" Storyboard.TargetProperty="X" To="18" Duration="0" />
                                                <DoubleAnimation Storyboard.TargetName="TrackOn" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="ContentStates">
                                        <VisualState x:Name="OffContent" />
                                        <VisualState x:Name="OnContent" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ============ Slider: a 4 DIP track, a white 22 DIP knob ============ -->
            <Style x:Key="SliderStyle" TargetType="Slider">
                <Setter Property="IsThumbToolTipEnabled" Value="False" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="ManipulationMode" Value="None" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Slider">
                            <Grid x:Name="SliderContainer" Background="Transparent">
                                <Grid x:Name="HorizontalTemplate" MinHeight="30">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Rectangle x:Name="HorizontalTrackRect" Grid.ColumnSpan="3" Height="4" RadiusX="2" RadiusY="2" Margin="11,0,11,0"
                                               Fill="{ThemeResource FillBrush}" />
                                    <Rectangle x:Name="HorizontalDecreaseRect" Height="4" RadiusX="2" RadiusY="2" Margin="11,0,-11,0"
                                               Fill="{ThemeResource AccentBrush}" />
                                    <Thumb x:Name="HorizontalThumb" Grid.Column="1" Width="22" Height="22" DataContext="{TemplateBinding Value}"
                                           AutomationProperties.AccessibilityView="Raw">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{ThemeResource KnobBrush}" Stroke="{ThemeResource KnobStrokeBrush}" StrokeThickness="0.75" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Grid>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver" />
                                        <VisualState x:Name="Pressed" />
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="SliderContainer.Opacity" Value="0.4" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ============ Segmented control: a track, the chosen segment a raised tile ============ -->
            <Style x:Key="SegmentTrackStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource FillBrush}" />
                <Setter Property="CornerRadius" Value="9" />
                <Setter Property="Padding" Value="2" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Right" />
            </Style>
            <Style x:Key="SegmentStyle" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Padding" Value="14,4,14,5" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid x:Name="Root" CornerRadius="7" Background="Transparent" Padding="{TemplateBinding Padding}">
                                <Grid.BackgroundTransition>
                                    <BrushTransition Duration="0:0:0.16" />
                                </Grid.BackgroundTransition>
                                <ContentPresenter x:Name="Content" Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Foreground="{TemplateBinding Foreground}" FontFamily="{StaticResource TextFont}" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="{ThemeResource HoverBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="{ThemeResource PressedBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Opacity" Value="0.4" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="CheckStates">
                                        <VisualState x:Name="Checked">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="{ThemeResource SegmentSelectedBrush}" />
                                                <Setter Target="Content.FontFamily" Value="{StaticResource EmphasisFont}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Unchecked" />
                                        <VisualState x:Name="Indeterminate" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ============ Sidebar item: the chosen page is an accent capsule ============ -->
            <Style x:Key="NavItemStyle" TargetType="ListViewItem">
                <Setter Property="Padding" Value="12,0,12,0" />
                <Setter Property="Margin" Value="0,0,0,2" />
                <Setter Property="MinHeight" Value="38" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                            <Grid x:Name="Root" CornerRadius="10" Background="Transparent" Padding="{TemplateBinding Padding}">
                                <Grid.BackgroundTransition>
                                    <BrushTransition Duration="0:0:0.14" />
                                </Grid.BackgroundTransition>
                                <ContentPresenter x:Name="Content" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"
                                                  Foreground="{TemplateBinding Foreground}" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="{ThemeResource HoverBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="{ThemeResource PressedBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Selected">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="{StaticResource AccentBrush}" />
                                                <Setter Target="Content.Foreground" Value="{StaticResource OnAccentBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="PointerOverSelected">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="{StaticResource AccentHoverBrush}" />
                                                <Setter Target="Content.Foreground" Value="{StaticResource OnAccentBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="PressedSelected">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="{StaticResource AccentPressedBrush}" />
                                                <Setter Target="Content.Foreground" Value="{StaticResource OnAccentBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Preset tile: a swatch and a name; the chosen one has an accent ring.
                 (No implicit transitions on parts a visual state sets: WinUI crashes on them.) -->
            <Style x:Key="PresetTileStyle" TargetType="RadioButton">
                <Setter Property="Padding" Value="10" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid x:Name="Root">
                                <Border x:Name="Surface" CornerRadius="16" BorderThickness="1" Padding="{TemplateBinding Padding}"
                                        Background="{ThemeResource CardBrush}" BorderBrush="{ThemeResource CardStrokeBrush}">
                                    <ContentPresenter Content="{TemplateBinding Content}" HorizontalContentAlignment="Stretch" />
                                </Border>
                                <Border x:Name="Ring" CornerRadius="16" BorderThickness="2" Opacity="0" IsHitTestVisible="False"
                                        BorderBrush="{StaticResource AccentBrush}" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Surface.BorderBrush" Value="{ThemeResource SeparatorBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed" />
                                        <VisualState x:Name="Disabled" />
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="CheckStates">
                                        <VisualState x:Name="Checked">
                                            <VisualState.Setters>
                                                <Setter Target="Ring.Opacity" Value="1" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Unchecked" />
                                        <VisualState x:Name="Indeterminate" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- A pinned app's row: no hover fill of its own (the row draws its own). -->
            <Style x:Key="PinItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="CornerRadius" Value="0" />
            </Style>
            <!-- Line drawings on the design page. -->
            <Style x:Key="GlyphInkStyle" TargetType="Shape">
                <Setter Property="Stroke" Value="{ThemeResource InkSecondaryBrush}" />
                <Setter Property="StrokeThickness" Value="1.5" />
                <Setter Property="StrokeLineJoin" Value="Round" />
            </Style>
            <Style x:Key="GlyphFaintStyle" TargetType="Shape">
                <Setter Property="Stroke" Value="{ThemeResource InkTertiaryBrush}" />
                <Setter Property="StrokeThickness" Value="1.25" />
            </Style>
            <Style x:Key="GlyphAccentStyle" TargetType="Shape">
                <Setter Property="Stroke" Value="{StaticResource AccentBrush}" />
                <Setter Property="StrokeThickness" Value="1.75" />
                <Setter Property="StrokeLineJoin" Value="Round" />
                <Setter Property="StrokeStartLineCap" Value="Round" />
                <Setter Property="StrokeEndLineCap" Value="Round" />
            </Style>
            <Style x:Key="GlyphAccentFillStyle" TargetType="Shape">
                <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
