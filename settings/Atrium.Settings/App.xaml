<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Atrium.Settings.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Type: Segoe UI Variable Display for large and numeric text, Text for everything else.
                 Scale 11 / 12 / 14 / 16 / 28 / 32 on a 4 px baseline. -->
            <FontFamily x:Key="DisplayFont">Segoe UI Variable Display</FontFamily>
            <FontFamily x:Key="TextFont">Segoe UI Variable Text</FontFamily>

            <Style x:Key="OverlineStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="140" />
                <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            </Style>
            <Style x:Key="PageTitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
                <Setter Property="FontSize" Value="32" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="-10" />
                <Setter Property="LineHeight" Value="40" />
                <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            </Style>
            <Style x:Key="PageSubtitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="120" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
            </Style>
            <Style x:Key="CardTitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
            <Style x:Key="CardDescriptionStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="LineHeight" Value="16" />
                <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="HintStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
            <Style x:Key="CaptionTertiaryStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
            </Style>
            <!-- Big tabular numerals for slider values. -->
            <Style x:Key="ValueStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="SemiLight" />
                <Setter Property="LineHeight" Value="32" />
                <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
                <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
            </Style>

            <!-- Cards -->
            <Style x:Key="CardSurfaceStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="20,16,20,16" />
            </Style>

            <!-- Vector illustrations on the cards. -->
            <Style x:Key="GlyphInkStyle" TargetType="Shape">
                <Setter Property="Stroke" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="StrokeThickness" Value="1.5" />
                <Setter Property="StrokeLineJoin" Value="Round" />
                <Setter Property="StrokeStartLineCap" Value="Round" />
                <Setter Property="StrokeEndLineCap" Value="Round" />
            </Style>
            <Style x:Key="GlyphFaintStyle" TargetType="Shape">
                <Setter Property="Stroke" Value="{ThemeResource TextFillColorTertiaryBrush}" />
                <Setter Property="StrokeThickness" Value="1.25" />
                <Setter Property="StrokeLineJoin" Value="Round" />
                <Setter Property="StrokeStartLineCap" Value="Round" />
                <Setter Property="StrokeEndLineCap" Value="Round" />
            </Style>
            <Style x:Key="GlyphAccentStyle" TargetType="Shape">
                <Setter Property="Stroke" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                <Setter Property="StrokeThickness" Value="1.75" />
                <Setter Property="StrokeLineJoin" Value="Round" />
                <Setter Property="StrokeStartLineCap" Value="Round" />
                <Setter Property="StrokeEndLineCap" Value="Round" />
            </Style>
            <Style x:Key="GlyphInkFillStyle" TargetType="Shape">
                <Setter Property="Fill" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Style>
            <Style x:Key="GlyphAccentFillStyle" TargetType="Shape">
                <Setter Property="Fill" Value="{ThemeResource AccentFillColorDefaultBrush}" />
            </Style>

            <!-- Segmented control that floats on the specimen (always over art, so fixed colours). -->
            <Style x:Key="SegToggleStyle" TargetType="ToggleButton">
                <Setter Property="Foreground" Value="#D9FFFFFF" />
                <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="14,5,14,6" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Grid x:Name="Root" Background="Transparent" CornerRadius="9" Padding="{TemplateBinding Padding}">
                                <ContentPresenter x:Name="Content" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="#1FFFFFFF" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="#33FFFFFF" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Checked">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="#F2FFFFFF" />
                                                <Setter Target="Content.Foreground" Value="#FF16181D" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="CheckedPointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="#FFFFFFFF" />
                                                <Setter Target="Content.Foreground" Value="#FF16181D" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="CheckedPressed">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="#E6FFFFFF" />
                                                <Setter Target="Content.Foreground" Value="#FF16181D" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Preset tile: a card with a rendered swatch, an accent ring when chosen. -->
            <Style x:Key="PresetTileStyle" TargetType="RadioButton">
                <Setter Property="Padding" Value="12" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid x:Name="Root">
                                <Border x:Name="Surface" CornerRadius="12" BorderThickness="1" Padding="{TemplateBinding Padding}"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                                      HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                                </Border>
                                <Border x:Name="Ring" CornerRadius="12" BorderThickness="2" Opacity="0" IsHitTestVisible="False"
                                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}">
                                </Border>
                                <Border x:Name="Badge" Width="20" Height="20" CornerRadius="10" Margin="0,20,20,0" Opacity="0"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" IsHitTestVisible="False"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}">
                                    <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                </Border>
                                <VisualStateManager.VisualStateGroups>
                                    <!-- RadioButton keeps pointer and check states in separate groups. -->
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Surface.Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Surface.Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled" />
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="CheckStates">
                                        <VisualState x:Name="Checked">
                                            <VisualState.Setters>
                                                <Setter Target="Ring.Opacity" Value="1" />
                                                <Setter Target="Badge.Opacity" Value="1" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Unchecked" />
                                        <VisualState x:Name="Indeterminate" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PinItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,0,0,8" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="CornerRadius" Value="12" />
            </Style>

            <Style x:Key="NavItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,0,0,4" />
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="CornerRadius" Value="10" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
