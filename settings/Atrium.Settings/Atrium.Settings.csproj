<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Atrium.Settings</RootNamespace>
    <AssemblyName>Atrium.Settings</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged and self-contained: runs from a plain folder, no runtime install. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Needed for `dotnet publish` to include the compiled XAML (.xbf) and resources.pri. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\atrium.ico</ApplicationIcon>
    <Version>0.9.3</Version>
    <Product>Atrium Desktop</Product>
    <Copyright>MIT License</Copyright>
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinUI component only: the metapackage would also ship AI/ML/Search/Widgets
         (onnxruntime, DirectML, ...) in a self-contained build. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.6.4" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\assets\atrium.ico" Link="Assets\atrium.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
