<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Atrium.Settings.SliderTile"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">

    <!-- One adjustable parameter on a tile: its name and value, the slider, a plain-language note. -->
    <Border x:Name="Surface" Style="{StaticResource TileStyle}">
        <Border.BackgroundTransition>
            <BrushTransition Duration="0:0:0.2" />
        </Border.BackgroundTransition>
        <Grid RowSpacing="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TitleText" Style="{StaticResource RowTitleStyle}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Style="{StaticResource ValueStyle}" VerticalAlignment="Center" IsTextScaleFactorEnabled="False">
                    <Run x:Name="ValueRun" /><Run x:Name="UnitRun" FontSize="13" />
                </TextBlock>
            </Grid>
            <Slider Grid.Row="1" x:Name="Track" Style="{StaticResource SliderStyle}" Margin="-11,0,-11,0" ValueChanged="OnTrackChanged" />
            <!-- The word for the value on a line of its own, so dragging never reflows the tile. -->
            <TextBlock Grid.Row="2" x:Name="HintText" FontSize="13" Foreground="{ThemeResource InkBrush}" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Row="3" x:Name="DescriptionText" Style="{StaticResource RowNoteStyle}" Margin="0,2,0,0" />
        </Grid>
    </Border>
</UserControl>
